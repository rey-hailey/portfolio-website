---
// Lab 갤러리 (LAB-R01, R02, R04)
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabCard from '../../components/lab/LabCard.astro';
import LabFilters from '../../components/lab/LabFilters.astro';
import { site } from '../../config/site';
import { getPublished } from '../../lib/content';
import { sortLabs, toolOptions } from '../../lib/lab';

const labs = sortLabs(await getPublished('lab'));
---

<BaseLayout title={`Lab | ${site.name}`} description="직접 만든 시제품과 도구를 모으고, 왜 만들었고 무엇을 배웠는지 적습니다." kind="Lab">
  <h1 class="font-display text-h1 font-semibold">Lab</h1>
  {
    labs.length === 0 ? (
      <p class="mt-8 text-ink-muted" data-testid="lab-empty">아직 공개한 Lab이 없습니다. 직접 만든 결과물을 곧 올리겠습니다.</p>
    ) : (
      <>
        <LabFilters tools={toolOptions(labs)} total={labs.length} />
        <ul class="mt-12 grid gap-12 md:grid-cols-2 lg:grid-cols-3">
          {labs.map((lab) => (
            <LabCard
              slug={lab.id}
              title={lab.data.title}
              oneLiner={lab.data.oneLiner}
              tools={lab.data.tools}
              status={lab.data.status}
              thumbnail={lab.data.thumbnail}
              thumbnailAlt={lab.data.thumbnailAlt}
            />
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>
