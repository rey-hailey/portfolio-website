---
// WRK-R04: 이전·다음 케이스. 없는 쪽은 생략
interface Props {
  prev?: { slug: string; title: string } | undefined;
  next?: { slug: string; title: string } | undefined;
}
const { prev, next } = Astro.props;
---

<nav aria-label="케이스 이동" class="mt-24 grid gap-6 border-t border-ink-line pt-8 sm:grid-cols-2">
  {
    prev && (
      <a href={`/work/${prev.slug}`} rel="prev" data-field="prev" class="flex flex-col gap-1 text-ink no-underline">
        <span class="text-small text-ink-muted">이전 케이스</span>
        <span class="font-semibold break-keep">{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a href={`/work/${next.slug}`} rel="next" data-field="next" class="flex flex-col gap-1 text-ink no-underline sm:col-start-2 sm:text-right">
        <span class="text-small text-ink-muted">다음 케이스</span>
        <span class="font-semibold break-keep">{next.title}</span>
      </a>
    )
  }
</nav>
