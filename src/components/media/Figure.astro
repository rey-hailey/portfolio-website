---
// 12-case-visuals: 본문 이미지 1장 + 캡션 + 라이트박스(<dialog>, Esc·바깥클릭·키보드). 디자인 토큰만.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  /** 원본 가로폭 미만일 때 확대하지 않도록 상한 지정(px). 미지정이면 컨테이너 폭. */
  maxWidth?: number | undefined;
  sizes?: string | undefined;
  class?: string | undefined;
}
const { src, alt, caption, maxWidth, sizes = '(min-width: 1024px) 860px, 100vw', class: cls = '' } = Astro.props;
const isSvg = src.format === 'svg';
const widths = [480, 960, 1440].filter((w) => w <= src.width);
if (widths.length === 0 || widths[widths.length - 1] < src.width) widths.push(src.width);
const style = maxWidth ? `max-width:${maxWidth}px` : undefined;
---

<figure class:list={['media-figure not-prose', cls]} data-figure style={style}>
  <button type="button" class="media-trigger" aria-label={`${alt} — 크게 보기`}>
    {isSvg ? <img src={src.src} alt={alt} class="media-img" loading="lazy" /> : <Image src={src} alt={alt} widths={widths} sizes={sizes} class="media-img" loading="lazy" />}
  </button>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
  <dialog class="media-lightbox" aria-label={alt}>
    {isSvg ? <img src={src.src} alt={alt} class="media-lightbox-img" loading="lazy" /> : <Image src={src} alt={alt} widths={[Math.min(src.width, 1600)]} sizes="92vw" class="media-lightbox-img" loading="lazy" />}
  </dialog>
</figure>
