---
// 12-case-visuals: 번호가 있는 3단계 세로 흐름(각 단계 = 라벨 + 이미지, 라이트박스).
// 13-work-readability: 바깥 <figure>(WRR-R05).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Step {
  label: string;
  src: ImageMetadata;
  alt: string;
}
interface Props {
  steps: Step[];
  caption?: string | undefined;
}
const { steps, caption } = Astro.props;
const widthsFor = (w: number) =>
  [620, 1240, w]
    .filter((x) => x <= w)
    .filter((x, i, a) => a.indexOf(x) === i);
---

<figure class="media-steps not-prose">
  <ol class="media-steps-list">
    {
      steps.map((s, i) => (
        <li class="media-step">
          <span class="media-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="media-step-body">
            <p class="media-step-label break-keep">{s.label}</p>
            <figure class="media-figure" data-figure>
              <button type="button" class="media-trigger" aria-label={`${s.alt} — 크게 보기`}>
                <Image src={s.src} alt={s.alt} widths={widthsFor(s.src.width)} sizes="(min-width:1024px) 620px, calc(100vw - 5rem)" class="media-img" loading="lazy" />
              </button>
              <dialog class="media-lightbox" aria-label={s.alt}>
                <Image src={s.src} alt={s.alt} widths={[Math.min(s.src.width, 1600)]} sizes="92vw" class="media-lightbox-img" loading="lazy" />
              </dialog>
            </figure>
          </div>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
