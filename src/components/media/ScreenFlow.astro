---
// 13-work-readability (WRR-R04·R06): 화면 상태가 차례로 이어지는 흐름. 번호 + 상태 라벨 + 화면(라이트박스).
// 데스크톱 3열(읽는 순서대로 줄바꿈), 모바일 1열. 라벨은 원본 Figma 프레임 이름을 쓴다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PROSE, WIDE } from './widths';

interface Step {
  label: string;
  src: ImageMetadata;
  alt: string;
  /** 화면 안 자막은 썸네일 크기에서 읽히지 않으므로 화면 아래에 그대로 옮겨 적는다 */
  speaker?: string | undefined;
  line?: string | undefined;
}
interface Props {
  steps: Step[];
  caption?: string | undefined;
  wide?: boolean | undefined;
}
const { steps, caption, wide = false } = Astro.props;
const cols = 3;
const slot = Math.floor(((wide ? WIDE : PROSE) - (cols - 1) * 16) / cols);
const widthsFor = (w: number) =>
  [slot, slot * 2, w]
    .filter((x) => x <= w)
    .filter((x, i, a) => a.indexOf(x) === i);
---

<figure class:list={['media-flow not-prose', wide && 'media-wide']}>
  <ol class="media-flow-list">
    {
      steps.map((s, i) => (
        <li class="media-flow-step">
          <p class="media-flow-label break-keep">
            <span class="media-flow-num">{String(i + 1).padStart(2, '0')}</span>
            {s.label}
            {i < steps.length - 1 && (
              <span class="media-flow-arrow" aria-hidden="true">
                →
              </span>
            )}
          </p>
          <figure class="media-figure" data-figure>
            <button type="button" class="media-trigger" aria-label={`${s.alt} — 크게 보기`}>
              <Image src={s.src} alt={s.alt} widths={widthsFor(s.src.width)} sizes={`(min-width:1024px) ${slot}px, calc(100vw - 3rem)`} class="media-img" loading="lazy" />
            </button>
            <dialog class="media-lightbox" aria-label={s.alt}>
              <Image src={s.src} alt={s.alt} widths={[Math.min(s.src.width, 1600)]} sizes="92vw" class="media-lightbox-img" loading="lazy" />
            </dialog>
          </figure>
          {s.line && (
            <p class="media-flow-line break-keep">
              {s.speaker && <span class="media-flow-speaker">{s.speaker}</span>}
              {s.line}
            </p>
          )}
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
