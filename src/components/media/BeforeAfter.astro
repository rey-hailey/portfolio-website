---
// 12-case-visuals: 라벨·화살표가 있는 개선 전/후 흐름. 텍스트 단계(flow) 또는 이미지 쌍(pairs) 두 모드.
// 13-work-readability: wide(WRR-R03), 바깥 <figure>(WRR-R05).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PROSE, WIDE } from './widths';

interface Flow {
  label: string;
  steps: string[];
}
interface Pair {
  label?: string;
  before: { src: ImageMetadata; alt: string };
  after: { src: ImageMetadata; alt: string };
}
interface VisualRow {
  label: string;
  items: { src: ImageMetadata; alt: string; chip: string }[];
  accent?: boolean;
}
interface Props {
  before?: Flow | undefined;
  after?: Flow | undefined;
  pairs?: Pair[] | undefined;
  visualRows?: VisualRow[] | undefined;
  headers?: [string, string] | undefined;
  caption?: string | undefined;
  wide?: boolean | undefined;
}
const { before, after, pairs, visualRows, headers, caption, wide = false } = Astro.props;
const widthsFor = (w: number, slot = 320) =>
  [slot, slot * 2, w]
    .filter((x) => x <= w)
    .filter((x, i, a) => a.indexOf(x) === i);
---

<figure class:list={['media-ba not-prose', wide && 'media-wide']}>
  {
    before && after && (
      <div class="media-ba-flows">
        {[before, after].map((flow, fi) => (
          <div class:list={['media-ba-row', fi === 1 && 'media-ba-row--after']}>
            <span class="media-ba-label">{flow.label}</span>
            <div class="media-ba-steps">
              {flow.steps.map((st, i) => (
                <>
                  {i > 0 && (
                    <span class="media-ba-arrow" aria-hidden="true">
                      →
                    </span>
                  )}
                  <span class="media-ba-chip break-keep">{st}</span>
                </>
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }
  {
    pairs && (
      <div class="media-ba-pairs">
        {headers && (
          <div class="media-ba-heads" aria-hidden="true">
            <span>{headers[0]}</span>
            <span />
            <span>{headers[1]}</span>
          </div>
        )}
        {pairs.map((p) => (
          <div class="media-ba-pair">
            {[p.before, p.after].map((img, idx) => (
              <>
                {idx === 1 && (
                  <span class="media-ba-arrow" aria-hidden="true">
                    →
                  </span>
                )}
                <figure class="media-figure media-ba-pairimg" data-figure>
                  <button type="button" class="media-trigger" aria-label={`${img.alt} — 크게 보기`}>
                    <Image src={img.src} alt={img.alt} widths={widthsFor(img.src.width, 300)} sizes="(min-width:1024px) 300px, calc(100vw - 4rem)" class="media-img" loading="lazy" />
                  </button>
                  <dialog class="media-lightbox" aria-label={img.alt}>
                    <Image src={img.src} alt={img.alt} widths={[Math.min(img.src.width, 1200)]} sizes="92vw" class="media-lightbox-img" loading="lazy" />
                  </dialog>
                </figure>
              </>
            ))}
          </div>
        ))}
      </div>
    )
  }
  {
    visualRows && (
      <div class="media-ba-visualrows">
        {visualRows.map((row) => {
          const slot = Math.floor(((wide ? WIDE : PROSE) - (row.items.length - 1) * 16) / row.items.length);
          return (
            <section class:list={['media-ba-visualrow', row.accent && 'media-ba-visualrow--accent']}>
              <p class="media-ba-visualrow-label">{row.label}</p>
              <div class="media-ba-visuals" style={`--visual-cols:${row.items.length}`}>
                {row.items.map((item) => (
                  <div class="media-ba-visualitem">
                    <figure class="media-figure media-ba-visualfig" data-figure>
                      <button type="button" class="media-trigger" aria-label={`${item.alt} — 크게 보기`}>
                        <Image
                          src={item.src}
                          alt={item.alt}
                          widths={widthsFor(item.src.width, slot)}
                          sizes={`(min-width:1024px) ${slot}px, calc(100vw - 3rem)`}
                          class="media-img"
                          loading="lazy"
                        />
                      </button>
                      <dialog class="media-lightbox" aria-label={item.alt}>
                        <Image src={item.src} alt={item.alt} widths={[item.src.width]} sizes="92vw" class="media-lightbox-img" loading="lazy" />
                      </dialog>
                    </figure>
                    <p class="media-ba-chip break-keep">{item.chip}</p>
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )
  }
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
