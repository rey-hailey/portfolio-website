---
// 사이트 헤더 (FND-R11 메뉴·이력서 CTA, FND-R12 현재 위치 aria-current)
import { site } from '../config/site';
import { isActivePath } from '../lib/nav';

const { pathname } = Astro.url;
---

<header class="border-b border-ink-line">
  <div class="mx-auto flex max-w-page flex-wrap items-center gap-x-8 gap-y-2 px-4 py-4 md:px-8">
    <a href="/" class="font-display font-semibold text-ink no-underline">{site.name}</a>
    <nav aria-label="주 메뉴" class="md:ml-auto">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          site.nav.map((item) => {
            const active = isActivePath(pathname, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'text-ink underline-offset-8',
                    active ? 'underline decoration-accent decoration-2' : 'no-underline hover:underline',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a href={site.cta.href} download class="bg-accent px-4 py-2 text-bg no-underline">{site.cta.label}</a>
  </div>
</header>
