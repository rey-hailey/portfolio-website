---
// 사이트 푸터 (FND-R16): 하단 메뉴, 연락처(값이 있을 때만), RSS, 저작권(빌드 연도)
import { site } from '../config/site';

const { email, linkedinUrl } = site.contact;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line">
  <div class="mx-auto flex max-w-page flex-col gap-4 px-4 py-8 text-small text-ink-muted md:px-8">
    <nav aria-label="하단 메뉴">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-muted no-underline hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="flex flex-wrap gap-x-6 gap-y-1">
      {email && (
        <li>
          <a href={`mailto:${email}`} class="text-ink-muted">{email}</a>
        </li>
      )}
      {linkedinUrl && (
        <li>
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-ink-muted">LinkedIn</a>
        </li>
      )}
      <li>
        <a href="/rss.xml" class="text-ink-muted">RSS</a>
      </li>
    </ul>
    <p>© {year} {site.name}</p>
  </div>
</footer>
