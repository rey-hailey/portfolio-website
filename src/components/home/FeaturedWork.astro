---
// HOME-R05 + 14-hire-readability (HIR-R01): 대표 Work 최대 3개. 카드마다 문제 / 한 일 / 결과 3줄(work-glance 원문 인용)과 metrics[0].
// 썸네일은 데스크톱 240px, 모바일은 제목 옆 작은 4:3. 없으면 렌더링하지 않는다
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  works: {
    slug: string;
    title: string;
    summary: string;
    thumbnail: ImageMetadata;
    thumbnailAlt: string;
    glance?: { problem: string; action: string; result: string } | undefined;
    metric?: { value: string; label: string } | undefined;
  }[];
}
const { works } = Astro.props;
const rows = (g: { problem: string; action: string; result: string }) => [
  { key: 'problem', label: '문제', text: g.problem },
  { key: 'action', label: '한 일', text: g.action },
  { key: 'result', label: '결과', text: g.result },
];
---

{
  works.length > 0 && (
    <section aria-labelledby="home-work" class="border-t border-ink-line py-16 md:py-32" data-testid="home-featured-work" data-reveal>
      <p class="eyebrow">01 · Work</p>
      <h2 id="home-work" class="mt-3 text-h2 font-semibold break-keep">대표 작업</h2>
      <ol class="mt-12 flex flex-col">
        {works.map((w, i) => (
          <li class="border-t border-ink-line">
            <a href={`/work/${w.slug}`} class="flex flex-col gap-5 py-8 text-ink no-underline md:flex-row-reverse md:items-start md:gap-10" data-testid="home-work-card">
              <div class="thumb-frame hidden w-full shrink-0 md:block md:w-60">
                <Image src={w.thumbnail} alt={w.thumbnailAlt} widths={[240, 480, 720, w.thumbnail.width]} sizes="240px" class="thumb-frame-img" loading="lazy" />
              </div>
              <span class="flex flex-1 flex-col gap-5">
                <span class="flex items-start gap-4">
                  <span class="font-display text-h2 text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <span class="flex-1 text-h3 font-semibold break-keep">
                    {w.title} <span class="text-accent" aria-hidden="true">↗</span>
                  </span>
                  <span class="thumb-frame w-24 shrink-0 md:hidden">
                    <Image src={w.thumbnail} alt={w.thumbnailAlt} widths={[96, 192, 288]} sizes="96px" class="thumb-frame-img" loading="lazy" />
                  </span>
                </span>
                {w.glance ? (
                  <dl class="glance-list">
                    {rows(w.glance).map((r) => (
                      <div class:list={['glance-row', r.key === 'result' && 'glance-row--result']} data-field={r.key}>
                        <dt class="glance-label">{r.label}</dt>
                        <dd class="glance-text break-keep">{r.text}</dd>
                      </div>
                    ))}
                  </dl>
                ) : (
                  <span class="text-ink-muted break-keep">{w.summary}</span>
                )}
                {w.metric && (
                  <span class="flex flex-wrap items-baseline gap-x-3" data-testid="home-work-metric">
                    <strong class="font-display text-h3 font-semibold text-accent">{w.metric.value}</strong>
                    <span class="text-small text-ink-muted break-keep">{w.metric.label}</span>
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
