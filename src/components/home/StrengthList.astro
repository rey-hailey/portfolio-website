---
// HOME-R02 + 14-hire-readability (HIR-R02): 강점 3개 = 주장(제목) · 설명 · 근거 문장(케이스 원문 인용) · 근거 숫자(케이스 metrics[0]) · 사례 링크.
// 장식 이미지는 두지 않는다. href·quote·metric은 근거 케이스가 공개된 경우에만 넘어온다
interface Props {
  strengths: {
    title: string;
    description: string;
    href?: string | undefined;
    quote?: string | undefined;
    metric?: { value: string; label: string } | undefined;
  }[];
}
const { strengths } = Astro.props;
---

<section aria-labelledby="home-strengths" class="border-t border-ink-line py-16 md:py-32" data-reveal>
  <p class="eyebrow">02 · Strengths</p>
  <h2 id="home-strengths" class="mt-3 text-h2 font-semibold break-keep">강점</h2>
  <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
    {
      strengths.map((s, i) => (
        <li class="flex flex-col gap-3" data-testid="home-strength">
          <span class="font-display text-small text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-h3 font-semibold break-keep">{s.title}</h3>
          <p class="text-ink-muted break-keep">{s.description}</p>
          {s.quote && (
            <p class="mt-2 border-l-2 border-ink-line pl-4 text-small text-ink-muted break-keep" data-testid="home-strength-quote">
              {s.quote}
            </p>
          )}
          {s.metric && (
            <p class="mt-2 flex flex-wrap items-baseline gap-x-3" data-testid="home-strength-metric">
              <strong class="font-display text-h3 font-semibold text-accent">{s.metric.value}</strong>
              <span class="text-small text-ink-muted break-keep">{s.metric.label}</span>
            </p>
          )}
          {s.href && (
            <a href={s.href} class="mt-1 inline-flex items-center gap-1 text-small text-accent underline underline-offset-4">
              사례 보기 <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ol>
</section>
