---
// HOME-R02: 강점 3개. href는 근거 콘텐츠가 공개된 경우에만 넘어온다
interface Props {
  strengths: { title: string; description: string; href?: string | undefined }[];
}
const { strengths } = Astro.props;
---

<section aria-labelledby="home-strengths" class="border-t border-ink-line py-16 md:py-32" data-reveal>
  <h2 id="home-strengths" class="text-h2 font-semibold break-keep">강점</h2>
  <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
    {
      strengths.map((s, i) => (
        <li class="flex flex-col gap-3">
          <span class="font-display text-small text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-h3 font-semibold break-keep">{s.title}</h3>
          <p class="text-ink-muted break-keep">{s.description}</p>
          {s.href && (
            <a href={s.href} class="mt-1 inline-flex items-center gap-1 text-small text-accent underline underline-offset-4">
              사례 보기 <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ol>
</section>
