---
// HOME-R02 + 12-case-visuals: 강점 3개. 각 카드 위 시각 자료는 index 순서로 매핑(about 스키마는 건드리지 않는다). href는 근거 콘텐츠가 공개된 경우에만 넘어온다
import { Image } from 'astro:assets';
import emotions from '../../assets/images/home/strengths/emotions.webp';
import logoOrc from '../../assets/images/home/strengths/logo-orc.webp';
import logoBrc from '../../assets/images/home/strengths/logo-brc.webp';
import logoOlb from '../../assets/images/home/strengths/logo-olb.webp';
import langZh from '../../assets/images/work/briefs/harmony-hills/lang-zh.webp';
import langRu from '../../assets/images/work/briefs/harmony-hills/lang-ru.webp';
import langVi from '../../assets/images/work/briefs/harmony-hills/lang-vi.webp';

interface Props {
  strengths: { title: string; description: string; href?: string | undefined }[];
}
const { strengths } = Astro.props;
const partnerLogos = [
  { src: logoOrc, alt: 'Oxford Reading Club 로고' },
  { src: logoBrc, alt: 'Big Reading Club 로고' },
  { src: logoOlb, alt: "Oxford Learner's Bookshelf 로고" },
];
---

<section aria-labelledby="home-strengths" class="border-t border-ink-line py-16 md:py-32" data-reveal>
  <p class="eyebrow">02 · Strengths</p>
  <h2 id="home-strengths" class="mt-3 text-h2 font-semibold break-keep">강점</h2>
  <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
    {
      strengths.map((s, i) => (
        <li class="flex flex-col gap-3">
          <div class="strength-visual">
            {i === 0 && <Image src={emotions} alt="Coco의 6가지 표정" widths={[320, 640]} sizes="(min-width:768px) 320px, 100vw" class="strength-visual-img" loading="lazy" />}
            {i === 1 && (
              <div class="strength-logos">
                {partnerLogos.map((l) => (
                  <Image src={l.src} alt={l.alt} widths={[l.src.width]} sizes="160px" class="strength-logo" loading="lazy" />
                ))}
              </div>
            )}
            {i === 2 && (
              <div class="strength-langs">
                <Image src={langZh} alt="Run Coco, Run! 중국어 화면" widths={[96, 192, langZh.width]} sizes="96px" class="strength-lang" loading="lazy" />
                <Image src={langRu} alt="Run Coco, Run! 러시아어 화면" widths={[96, 192, langRu.width]} sizes="96px" class="strength-lang" loading="lazy" />
                <Image src={langVi} alt="Run Coco, Run! 베트남어 화면" widths={[96, 192, langVi.width]} sizes="96px" class="strength-lang" loading="lazy" />
              </div>
            )}
          </div>
          <span class="font-display text-small text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-h3 font-semibold break-keep">{s.title}</h3>
          <p class="text-ink-muted break-keep">{s.description}</p>
          {s.href && (
            <a href={s.href} class="mt-1 inline-flex items-center gap-1 text-small text-accent underline underline-offset-4">
              사례 보기 <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ol>
</section>
