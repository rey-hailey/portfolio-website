---
// HOME-R06 + 14-hire-readability (HIR-R03): 일하는 방식 4가지 (D12). 제목 "이렇게 일합니다"는 포트폴리오 30쪽 원문.
// 설명은 케이스 원문 문장, 숫자는 별도 칸
interface Props {
  items: { title: string; description: string; metricValue?: string | null | undefined; metricLabel?: string | null | undefined }[];
}
---

<section aria-labelledby="home-style" class="border-t border-ink-line py-16 md:py-32" data-reveal>
  <p class="eyebrow">03 · How I Work</p>
  <h2 id="home-style" class="mt-3 text-h2 font-semibold break-keep">이렇게 일합니다</h2>
  <ol class="mt-12 grid gap-12 md:grid-cols-2">
    {
      Astro.props.items.map((item, i) => (
        <li class="flex flex-col gap-3" data-testid="home-style-item">
          <span class="font-display text-small text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-h3 font-semibold break-keep">{item.title}</h3>
          <p class="text-ink-muted break-keep">{item.description}</p>
          {item.metricValue && (
            <p class="mt-1 flex flex-wrap items-baseline gap-x-3" data-testid="home-style-metric">
              <strong class="font-display text-h3 font-semibold text-accent">{item.metricValue}</strong>
              {item.metricLabel && <span class="text-small text-ink-muted break-keep">{item.metricLabel}</span>}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>
