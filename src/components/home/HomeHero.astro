---
// HOME-R01: 로고타입(사이트 이름) + 한 줄 정체성(H1)
interface Props {
  siteName: string;
  headline: string;
}
const { siteName, headline } = Astro.props;
---

<section class="flex min-h-[72vh] flex-col justify-center gap-6 pb-16 md:min-h-[82vh] md:pb-32">
  <p class="font-display text-h3 font-semibold text-accent">{siteName}</p>
  <h1 class="font-display text-display leading-tight font-semibold break-keep max-w-[20ch]">{headline}</h1>
  <p class="mt-6 flex items-center gap-3 text-small text-ink-muted" aria-hidden="true">
    <span>SCROLL</span>
    <span class="h-px w-12 bg-ink-line"></span>
  </p>
</section>
