---
// 16-case-diagrams (DGM-R03): Meet the Character 작동 구조. 노드를 누르면 하는 일 · 들어가는 것 · 나가는 것 · 연결 · 설계 결정이 패널(모바일은 아래 시트)에 뜬다.
// 도식 좌표는 사이트 주인 포트폴리오 Artifact 그대로, 색은 토큰 클래스. 스크립트는 이 컴포넌트를 쓰는 페이지(LAURA 상세)에만 번들된다.
// JS가 없으면 도식 · 기본 노드(judge) 설명 · 설계 결정 목록이 그대로 보인다.
import { mtcDiagram, type MtcNodeId } from '../../data/mtc-diagram';

const d = mtcDiagram;
const DEFAULT: MtcNodeId = 'judge';
const circled = ['', '①', '②', '③', '④', '⑤'];
const node = d.nodes[DEFAULT];
const pinsOf = (id: MtcNodeId) => (d.nodes[id].pins ?? []).map((p) => d.decisions.find((x) => x.id === p)!);
// 모바일 목록 (Artifact 순서). scope=ov는 '개요' 탭에서만 보인다
const LIST: { phase?: string; scope?: 'ov'; n?: MtcNodeId; label?: string; sub?: boolean; pins?: number[] }[] = [
  { phase: '대화 시작', scope: 'ov' },
  { n: 'greet', label: '먼저 인사 · 쉬운 질문', scope: 'ov' },
  { phase: '대화 중 · 아이 차례마다 ↺ 반복' },
  { n: 'speak', label: '아이가 말함' },
  { n: 'judge', label: '기억이 필요한가?', pins: [1, 4] },
  { n: 'childmem', label: '지난 이야기 · 취향 · 가족 → 아이 기억', sub: true, pins: [2] },
  { n: 'world', label: '캐릭터 · 마을 질문 → 세계관', sub: true },
  { n: 'skip', label: '맞장구 · 인사 · 작별 → 검색 없이', sub: true },
  { n: 'answer', label: '대답 생성 + 감정 1개' },
  { n: 'react', label: '표정 · 목소리로 대답' },
  { phase: '대화 끝', scope: 'ov' },
  { n: 'farewell', label: '작별 인사', scope: 'ov' },
  { phase: '대화 후', scope: 'ov' },
  { n: 'analysis', label: '대화 유형 분석 → 리포트', scope: 'ov' },
  { n: 'extract', label: '기억 정리 · 추가 · 수정 · 유지', scope: 'ov', pins: [3] },
  { n: 'childmem', label: '아이 기억에 저장', scope: 'ov', pins: [2] },
  { n: 'report', label: '관계 리포트 · 기억 확인 · 삭제', scope: 'ov', pins: [5] },
];
const laneClass = (id: MtcNodeId) => (d.nodes[id].lane === '프롬프트' ? 'pr' : d.nodes[id].lane === '저장소' ? 'st' : 'sc');
---

<figure class="dgm dgm-sd media-wide not-prose" data-sd>
  <div class="dgm-sd-bar">
    <div class="dgm-seg" role="tablist" aria-label="도식 보기">
      <button type="button" role="tab" id="sd-tab-ov" aria-selected="true" aria-controls="sd-ov" data-sd-tab="ov">개요</button>
      <button type="button" role="tab" id="sd-tab-turn" aria-selected="false" aria-controls="sd-turn" data-sd-tab="turn" tabindex="-1">아이가 한 번 말할 때</button>
    </div>
  </div>

  <div class="dgm-sd-ex">
    <div class="dgm-sd-ex-head">
      <p class="dgm-sd-ex-title">실제 대화 따라가기</p>
      <div class="dgm-sd-ex-steps" role="group" aria-label="실제 대화 단계">
        {d.examples.map((e) => <button type="button" data-sd-ex={e.id} aria-pressed="false">{e.id}</button>)}
      </div>
    </div>
    <div class="dgm-sd-ex-body" data-sd-ex-body aria-live="polite">
      <p class="dgm-sd-muted">테스트 계정의 실제 대화 두 건입니다. 1~4를 누르면 도식에서 그 단계가 강조됩니다.</p>
    </div>
  </div>

  <div class="dgm-sd-grid">
